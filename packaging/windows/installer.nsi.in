Unicode true
!include "MUI2.nsh"
!include "x64.nsh"
!include "LogicLib.nsh"
Name "Agent Canary Community 3.0 candidate.3"
OutFile "__OUTPUT__"
InstallDir "$LOCALAPPDATA\AgentCanary\Community-candidate.3"
RequestExecutionLevel user
SetCompressor zlib
ShowInstDetails show
ShowUninstDetails show
!define MUI_ABORTWARNING
!define MUI_CUSTOMFUNCTION_ABORT AgentCanaryAbortCleanup
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "__LICENSE__"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\AgentCanary.exe"
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_LANGUAGE "English"
Var InstallTxn
Var M7LifecycleMarkerPath
Var M7LifecycleMarkerHandle
Var M7LifecyclePhase
Var M7LifecycleMarkerEnabled
Var M7LifecyclePreviousError
Function RollbackInstall
 StrCmp $InstallTxn 1 0 rollback_done
 StrCpy $InstallTxn 0
 SetShellVarContext current
 StrCpy $2 0
__ROLLBACK_REPARSE_CHECKS__
 ${If} $2 == 1
  Goto rollback_incomplete
 ${EndIf}
 ClearErrors
 SetOutPath "$TEMP"
__ROLLBACK_DELETE__
 Delete "$INSTDIR\INSTALL_RECEIPT.json"
 Delete "$INSTDIR\Uninstall.exe"
__ROLLBACK_RMDIR__
 RMDir "$INSTDIR"
 Delete "__START_MENU__\Agent Canary.lnk"
 RMDir "__START_MENU__"
 Delete "__DESKTOP_SHORTCUT__"
 DeleteRegKey HKCU "__REGISTRY_KEY__"
 IfErrors rollback_incomplete rollback_done
 rollback_incomplete:
 IfSilent rollback_done
 MessageBox MB_ICONEXCLAMATION|MB_OK "Rollback was incomplete. Some owned files remain in the selected install directory. / 回滚未完全完成，所选目录中仍有部分安装文件。" /SD IDOK
 rollback_done:
FunctionEnd
Function AgentCanaryAbortCleanup
 Call RollbackInstall
FunctionEnd
Function .onInstFailed
 Call RollbackInstall
FunctionEnd
Function WriteM7LifecyclePhase
 StrCpy $M7LifecyclePreviousError 0
 IfErrors 0 +2
  StrCpy $M7LifecyclePreviousError 1
 StrCmp $M7LifecycleMarkerPath "" m7_lifecycle_phase_done
 ClearErrors
 FileOpen $M7LifecycleMarkerHandle "$M7LifecycleMarkerPath" w
 IfErrors m7_lifecycle_phase_done
 FileWrite $M7LifecycleMarkerHandle "$M7LifecyclePhase$\r$\n"
 FileClose $M7LifecycleMarkerHandle
 m7_lifecycle_phase_done:
 ClearErrors
 StrCmp $M7LifecyclePreviousError "1" 0 +2
  SetErrors
FunctionEnd
Function .onInit
 ReadEnvStr $M7LifecycleMarkerEnabled "AGENT_CANARY_M7_PHASE_MARKER"
 SetShellVarContext current
 ; EFS-encrypted install paths fail NSIS uninstaller startup in the tested
 ; Windows profile. Keep LocalAppData untouched and choose a user-writable,
 ; non-encrypted profile path when its parent is EFS-encrypted.
 System::Call 'kernel32::GetFileAttributesW(w "$LOCALAPPDATA") i.r0'
 IntOp $1 $0 & 0x4000
 ${If} $0 != -1
 ${AndIf} $1 != 0
  StrCpy $INSTDIR "$PROFILE\Agent Canary Community\Community-candidate.3"
  IfSilent efs_notice_done
  MessageBox MB_ICONEXCLAMATION|MB_OK "Local AppData uses EFS encryption. The default install path was moved to a current-user profile folder so the uninstaller can run. You may choose another non-encrypted path. / 本机 Local AppData 已启用 EFS 加密。为确保卸载器可运行，默认安装位置已改为当前用户目录；也可选择其他未加密位置。"
efs_notice_done:
 ${EndIf}
 ${IfNot} ${RunningX64}
  MessageBox MB_ICONSTOP "Windows x64 required / 需要 64 位 Windows"
  Abort
 ${EndIf}
 SetRegView 64
 ReadRegStr $0 HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion" "CurrentBuildNumber"
 IntCmp $0 22000 win11 old win11
 old:
  MessageBox MB_ICONSTOP "Windows 11 required / 需要 Windows 11"
  Abort
 win11:
 ReadRegDWORD $0 HKLM "SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" "Release"
 IntCmp $0 528040 netok oldnet netok
 oldnet:
  MessageBox MB_ICONSTOP "Built-in .NET Framework 4.8 unavailable. Repair Windows components / 请修复 Windows .NET 组件。"
  Abort
 netok:
FunctionEnd
Section "Community"
 SetShellVarContext current
 ; Check the selected directory and its existing parents before writing files.
 ; If the target does not exist, walk upward to the nearest existing directory.
 StrCpy $2 "$INSTDIR"
 efs_path_check:
 System::Call 'kernel32::GetFileAttributesW(w "$2") i.r0'
 ${If} $0 != -1
  IntOp $1 $0 & 0x4000
  ${If} $1 != 0
   MessageBox MB_ICONSTOP "EFS-encrypted install paths are not supported by this uninstaller. Choose a non-encrypted current-user path. / 不支持 EFS 加密的安装目录，请选择未加密的当前用户目录。"
   Abort
  ${EndIf}
  Goto efs_path_ok
 ${EndIf}
 GetFullPathName $3 "$2\.."
 ${If} $3 == $2
  MessageBox MB_ICONSTOP "Could not verify the install path. Choose an existing writable parent directory. / 无法验证安装路径，请选择已有且可写的父目录。"
  Abort
 ${EndIf}
 StrCpy $2 "$3"
 Goto efs_path_check
 efs_path_ok:
 IfFileExists "$INSTDIR\*" 0 empty
 MessageBox MB_ICONSTOP "Target directory is not empty. Choose a new directory / 目标目录非空，请选择新目录。"
 Abort
 empty:
 ReadRegStr $0 HKCU "__REGISTRY_KEY__" "InstallLocation"
 ${If} $0 != ""
  MessageBox MB_ICONSTOP "This candidate is already registered. Uninstall it before reinstalling. / 此候选版本已注册，请先卸载后再安装。" /SD IDOK
  Abort
 ${EndIf}
 IfFileExists "__START_MENU__\Agent Canary.lnk" shortcut_conflict 0
 IfFileExists "__DESKTOP_SHORTCUT__" shortcut_conflict 0
 Goto shortcut_clear
 shortcut_conflict:
 MessageBox MB_ICONSTOP "A shortcut already exists. Remove it or choose another candidate version. / 快捷方式已存在，请先移除或选择其他候选版本。" /SD IDOK
 Abort
 shortcut_clear:
 System::Call 'kernel32::GetFileAttributesW(w "__START_MENU__") i.r0'
 ${If} $0 != -1
  Goto shortcut_conflict
 ${EndIf}
 StrCpy $InstallTxn 1
 SetOutPath "$INSTDIR"
 StrCmp $M7LifecycleMarkerEnabled "1" 0 m7_lifecycle_marker_disabled
 StrCpy $M7LifecycleMarkerPath "$INSTDIR\.m7-installer-lifecycle-phase"
m7_lifecycle_marker_disabled:
 StrCpy $M7LifecyclePhase "FILE_COPY_STARTED"
 Call WriteM7LifecyclePhase
 ClearErrors
 File /r "__PAYLOAD__\*"
 IfErrors install_failed
 StrCpy $M7LifecyclePhase "FILE_COPY_COMPLETE"
 Call WriteM7LifecyclePhase
 StrCpy $M7LifecyclePhase "RECORD_INSTALL_STARTED"
 Call WriteM7LifecyclePhase
 ClearErrors
 nsExec::ExecToStack '"$INSTDIR\runtime\node.exe" "$INSTDIR\worker.mjs" record-install "$LOCALAPPDATA\AgentCanaryCommunityData" unspecified __ANCHOR__ "$EXEPATH"'
 Pop $0
 Pop $1
 ${If} $0 != 0
  MessageBox MB_ICONSTOP "Integrity receipt failed. Installation was not registered / 完整性记录失败，安装未登记。"
  Call RollbackInstall
  Abort
 ${EndIf}
 StrCpy $M7LifecyclePhase "RECORD_INSTALL_COMPLETE"
 Call WriteM7LifecyclePhase
 ClearErrors
 WriteUninstaller "$INSTDIR\Uninstall.exe"
 CreateDirectory "__START_MENU__"
 CreateShortCut "__START_MENU__\Agent Canary.lnk" "$INSTDIR\AgentCanary.exe"
 CreateShortCut "__DESKTOP_SHORTCUT__" "$INSTDIR\AgentCanary.exe"
 WriteRegStr HKCU "__REGISTRY_KEY__" "DisplayName" "__PRODUCT_NAME__"
 WriteRegStr HKCU "__REGISTRY_KEY__" "DisplayVersion" "__PRODUCT_VERSION__"
 WriteRegStr HKCU "__REGISTRY_KEY__" "Publisher" "DorianChn (unsigned candidate)"
 WriteRegStr HKCU "__REGISTRY_KEY__" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
 WriteRegStr HKCU "__REGISTRY_KEY__" "InstallLocation" "$INSTDIR"
 WriteRegDWORD HKCU "__REGISTRY_KEY__" "NoModify" 1
 WriteRegDWORD HKCU "__REGISTRY_KEY__" "NoRepair" 1
 IfErrors install_failed
 StrCpy $M7LifecyclePhase "INSTALL_REGISTERED"
 Call WriteM7LifecyclePhase
 StrCpy $InstallTxn 0
 Goto install_done
 install_failed:
 Call RollbackInstall
 MessageBox MB_ICONSTOP|MB_OK "Installation failed. Rollback was attempted; check the install directory if files remain. / 安装失败，已尝试回滚；如仍有文件，请检查安装目录。" /SD IDOK
 Abort
 install_done:
SectionEnd
Section "Uninstall"
 SetShellVarContext current
 ; Reject redirected resources before deleting any owned file.
__REPARSE_CHECKS__
 ClearErrors
 SetOutPath "$TEMP"
__DELETE__
__RMDIR__
 IfErrors uninstall_incomplete
 Delete "$INSTDIR\INSTALL_RECEIPT.json"
 IfErrors uninstall_incomplete
 Delete "__START_MENU__\Agent Canary.lnk"
 RMDir "__START_MENU__"
 Delete "__DESKTOP_SHORTCUT__"
 IfErrors uninstall_incomplete
 Delete "$INSTDIR\Uninstall.exe"
 IfErrors uninstall_incomplete
 DeleteRegKey HKCU "__REGISTRY_KEY__"
 ClearErrors
 RMDir "$INSTDIR"
 Goto uninstall_done
uninstall_incomplete:
 IfSilent uninstall_done
 MessageBox MB_ICONEXCLAMATION|MB_OK "Uninstall was incomplete. Some paths could not be removed. Resolve the access or retained-file issue and retry. / 卸载未完成，部分路径无法删除；请处理访问权限或残留文件问题后重试。" /SD IDOK
uninstall_done:
 ; Never recursively delete installation directory. Retain reports and unknown files.
SectionEnd
