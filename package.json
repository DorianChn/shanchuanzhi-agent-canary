{
  "name": "@dorianchn/agent-canary",
  "version": "3.0.0",
  "description": "Agent Canary 3.0 open-source MCP and SDK security toolkit for AI agents.",
  "license": "MIT",
  "author": "DorianChn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DorianChn/shanchuanzhi-agent-canary.git"
  },
  "homepage": "https://github.com/DorianChn/shanchuanzhi-agent-canary#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": "https://github.com/DorianChn/shanchuanzhi-agent-canary/issues",
  "keywords": [
    "mcp",
    "security",
    "prompt-injection",
    "canary",
    "honeypot",
    "ai-agents",
    "llm",
    "agent-security",
    "devtools"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-canary": "dist/competition.js"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    }
  },
  "files": [
    "dist",
    "FREE_BUILD_VERSION.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/gateway.test.ts test/honeypot-runtime.test.ts test/runtime-console.test.ts test/file-state-store.test.ts test/evidence-conformance.test.ts test/gateway-acceptance.test.ts test/product-identity.test.ts",
    "ai:console": "node dist/competition.js ai console",
    "lab:agent": "node competition-submission/lab/run-agent-eval.mjs --profile=neutral_agent --v2",
    "types:check": "node scripts/check-sdk-types.mjs",
    "acceptance:offline": "npm run self-test && npm run types:check && node reproduction-kit/verify-community-manifest.mjs . && node reproduction-kit/run-offline-demo.mjs --root=.",
    "self-test": "node dist/competition.js self-test --json",
    "pack:check": "node scripts/check-package.mjs",
    "e4:auto": "npm run build && node security-lab/e4/run.mjs",
    "e4:verify": "node security-lab/e4/verify-bundle.mjs",
    "verify": "npm run build && npm test && npm run acceptance:offline && npm run pack:check",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
